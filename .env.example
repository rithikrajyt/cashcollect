# CashCollect Finance OS — Environment Variables
# Copy this file to .env.local and fill in values.
# Never commit .env.local or real credentials.

# --- Supabase public configuration ---
# Get these from your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only Supabase credential ---
# Never prefix with NEXT_PUBLIC_. Never expose to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Demo / MCP configuration ---
# Generate a strong random token: openssl rand -hex 32
MCP_DEMO_BEARER_TOKEN=
# The demo organization UUID (seeded in the database)
MCP_DEMO_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
# Public URL of the app (used for links in MCP responses)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Demo mode ---
# Set to true for local testing without Supabase
# Uses in-memory data store instead of Supabase PostgreSQL
DEMO_MODE=true

# --- Demo authentication ---
# Login credentials for the demo workspace
DEMO_USER_EMAIL=demo@cashcollect.app
DEMO_USER_PASSWORD=demo2026
# Session signing secret (generate a strong random value for production)
SESSION_SECRET=

# --- Optional: Email delivery (deterministic, no AI) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Optional: Protected reminder dispatcher ---
CRON_SECRET=
